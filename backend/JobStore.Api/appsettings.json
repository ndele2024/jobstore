{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=jobstore;Username=postgres;Password=postgres"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Security": {
    "JwtIssuer": "JobStore",
    "JwtAudience": "JobStore.Client",
    "JwtSigningKey": "jobstore-development-signing-key-please-change-me-32chars",
    "TokenLifetimeMinutes": 480,
    "ExposeVerificationCode": true,
    "DemoVerificationCode": "123456",
    "VerificationCodeLifetimeMinutes": 10
  }
}
